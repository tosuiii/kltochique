<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetCacheService</AssemblyName>
    <!-- NativeAOT (binário nativo, sem runtime .NET/IL): habilite com -p:Aot=true no publish.
         Requer clang + Windows SDK (Build Tools) no Windows; suporte a WinForms é experimental. -->
    <PublishAot Condition="'$(Aot)'=='true'">true</PublishAot>
    <StripSymbols Condition="'$(Aot)'=='true'">true</StripSymbols>
    <OptimizationPreference Condition="'$(Aot)'=='true'">Speed</OptimizationPreference>
  </PropertyGroup>
</Project>
